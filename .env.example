# Copy this file to ".env" and fill in your values. Never share or commit ".env".

# Discord bot token (Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN

# Command prefix (case-insensitive). Keep the quotes: they preserve the trailing space.
COMMAND_PREFIX="i novel "

# Logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# SQLite database file (created automatically)
DATABASE_NAME=novel_index.db

# How often the whole server is re-checked, in hours (1-168). Default: 24.
# The first check runs when the bot starts; between checks it only watches new messages.
SCAN_INTERVAL_HOURS=24

# Channel ID for duplicate alerts and scan reports.
# Leave as 0 to have the bot reply directly under the repeated link instead.
ALERT_CHANNEL_ID=0
